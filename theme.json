{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#231f20",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#00d1ff",
					"name": "OKFN Blue",
					"slug": "okfn-blue"
				},
				{
					"color": "#adffed",
					"name": "OKFN Green",
					"slug": "okfn-green"
				},
				{
					"color": "#e077ff",
					"name": "OKFN Purple",
					"slug": "okfn-purple"
				},
				{
					"color": "#e4ff36",
					"name": "OKFN Yellow",
					"slug": "okfn-yellow"
				},
				{
					"color": "#f8f8f8",
					"name": "OKFN Light Gray",
					"slug": "okfn-light-gray"
				},
				{
					"color": "#006cb8",
					"name": "OKFN Link",
					"slug": "okfn-link"
				}
			]
		},
		"layout": {
			"contentSize": "56rem",
			"wideSize": "84rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1.25rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "2rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "3rem",
					"slug": "60"
				},
				{
					"name": "XL",
					"size": "5rem",
					"slug": "70"
				},
				{
					"name": "2XL",
					"size": "6rem",
					"slug": "80"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"name": "HK Grotesk",
					"slug": "hk-grotesk",
					"fontFamily": "\"HK Grotesk\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-Regular.woff2" ]
						},
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-Italic.woff2" ]
						},
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-Medium.woff2" ]
						},
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-MediumItalic.woff2" ]
						},
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-Bold.woff2" ]
						},
						{
							"fontFamily": "HK Grotesk",
							"fontStyle": "italic",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hk-grotesk/HKGrotesk-BoldItalic.woff2" ]
						}
					]
				},
				{
					"name": "Necto Mono",
					"slug": "necto-mono",
					"fontFamily": "\"Necto Mono\", ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "Necto Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/necto-mono/nectomono-regular.otf" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1rem"
					}
				},
				{
					"name": "OKFN SM",
					"slug": "okfn-sm",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1rem"
					}
				},
				{
					"name": "OKFN MD",
					"slug": "okfn-md",
					"size": "1.375rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "OKFN LG",
					"slug": "okfn-lg",
					"size": "2.5rem",
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					}
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.6875rem",
						"max": "2.5rem"
					}
				},
				{
					"name": "H1",
					"slug": "xx-large",
					"size": "3.4375rem",
					"fluid": {
						"min": "2.0625rem",
						"max": "3.4375rem"
					}
				},
				{
					"name": "H0",
					"slug": "huge",
					"size": "6.25rem",
					"fluid": {
						"min": "3.125rem",
						"max": "6.25rem"
					}
				}
			]
		},
		"custom": {
			"radius": {
				"button": "1.25rem",
				"pill": "2.1875rem",
				"submenu": "3.75rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|hk-grotesk",
			"fontSize": "var:preset|font-size|okfn-md",
			"fontWeight": "400",
			"lineHeight": "1.4"
		},
		"css": "html{scroll-behavior:smooth;}body{overscroll-behavior-y:none;}img{max-width:100%;height:auto;}",
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--button)"
				},
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "1.1875rem",
						"bottom": "1.1875rem",
						"left": "3rem",
						"right": "3rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|hk-grotesk",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|okfn-purple"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|okfn-purple",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|contrast",
						"offset": "3px",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700",
					"lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|okfn-md",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|hk-grotesk",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|okfn-link"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":active": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|contrast",
						"offset": "2px",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"radius": "var(--wp--custom--radius--pill)",
							"style": "solid",
							"width": "2px"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"border": {
								"color": "transparent"
							},
							"color": {
								"background": "var:preset|color|okfn-blue",
								"text": "var:preset|color|base"
							}
						},
						":active": {
							"color": {
								"background": "var:preset|color|okfn-purple",
								"text": "var:preset|color|base"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "1rem"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|necto-mono",
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|okfn-blue"
							},
							"typography": {
								"textDecoration": "none"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|okfn-purple"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|okfn-blue"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|okfn-lg",
					"lineHeight": "1.2"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var:preset|font-family|necto-mono",
							"fontSize": "var:preset|font-size|large",
							"fontStyle": "normal"
						}
					}
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-radius:2.1875rem;border:2px solid var(--wp--preset--color--contrast);padding-left:1.25rem;padding-right:1.25rem;}",
				"elements": {
					"button": {
						"border": {
							"radius": "2.1875rem"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|okfn-blue"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [ "page" ],
			"title": "Page without title"
		}
	]
}
