{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Dark mode",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#231f20",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#ffffff",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#00d1ff",
					"name": "OKFN Blue",
					"slug": "okfn-blue"
				},
				{
					"color": "#adffed",
					"name": "OKFN Green",
					"slug": "okfn-green"
				},
				{
					"color": "#e077ff",
					"name": "OKFN Purple",
					"slug": "okfn-purple"
				},
				{
					"color": "#e4ff36",
					"name": "OKFN Yellow",
					"slug": "okfn-yellow"
				},
				{
					"color": "#3a3637",
					"name": "OKFN Light Gray",
					"slug": "okfn-light-gray"
				},
				{
					"color": "#00d1ff",
					"name": "OKFN Link",
					"slug": "okfn-link"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"css": ":root{--okfn-accent:var(--wp--preset--color--okfn-blue);} .has-bg-circle::before,.is-style-orb-blue::before,.is-style-orb-green::before,.is-style-orb-purple::before,.is-style-orb-yellow::before{mix-blend-mode:screen;} .okfn-feature-card{border-color:var(--wp--preset--color--contrast);}",
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|okfn-link"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			}
		}
	}
}
