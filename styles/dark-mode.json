{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Dark mode",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#121214",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#f4f4f5",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#00d1ff",
					"name": "OKFN Blue",
					"slug": "okfn-blue"
				},
				{
					"color": "#2dd4bf",
					"name": "OKFN Green",
					"slug": "okfn-green"
				},
				{
					"color": "#c084fc",
					"name": "OKFN Purple",
					"slug": "okfn-purple"
				},
				{
					"color": "#facc15",
					"name": "OKFN Yellow",
					"slug": "okfn-yellow"
				},
				{
					"color": "#27272a",
					"name": "OKFN Light Gray",
					"slug": "okfn-light-gray"
				},
				{
					"color": "#38bdf8",
					"name": "OKFN Link",
					"slug": "okfn-link"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|okfn-link"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			}
		}
	}
}
